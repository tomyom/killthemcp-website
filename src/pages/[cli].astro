      github: 'https://github.com/ktmcp-cli/tisane',
      category: 'Other',
      features: [
        'Content moderation',
        'Hate speech detection',
        'Sentiment analysis',
        'Entity extraction',
        'Topic detection',
        'Multi-language support'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up API key
tisane auth login --api-key YOUR_API_KEY

# Verify connection
tisane auth status`
        },
        {
          title: 'Analyze text',
          code: `# Analyze text for moderation
tisane analyze \\
  --text "Text to analyze" \\
  --language en

# Parse for entities
tisane parse \\
  --text "John Smith visited Paris last Tuesday" \\
  --language en`
        }
      ]
    },
    {
      name: 'Twilio',
      slug: 'twilio-cli',
      package: '@ktmcp-cli/twilio',
      description: 'SMS, calls, and phone numbers',
      longDescription: 'Twilio is the world\'s leading cloud communications platform. This CLI provides access to SMS messaging, voice calls, phone number management, and the full Twilio REST API for automating communications from the terminal.',
      github: 'https://github.com/ktmcp-cli/twilio',
      category: 'Messaging',
      features: [
        'Send and receive SMS',
        'Make and receive calls',
        'Phone number management',
        'Message status tracking',
        'Call recording access',
        'Messaging service management'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up credentials
twilio auth login --account-sid YOUR_SID --auth-token YOUR_TOKEN

# Verify connection
twilio auth status`
        },
        {
          title: 'Send messages',
          code: `# Send an SMS
twilio messages send \\
  --to +15550001234 \\
  --from +15559998765 \\
  --body "Hello World!"

# List sent messages
twilio messages list --limit 10`
        }
      ]
    },
    {
      name: 'Up Bank',
      slug: 'upbank-cli',
      package: '@ktmcp-cli/upbank',
      description: 'Australian neobank API',
      longDescription: 'Up Bank is an Australian neobank with a clean developer API. This CLI provides access to accounts, transactions, categories, and spending insights for automating your personal finance tracking from the terminal.',
      github: 'https://github.com/ktmcp-cli/upbank',
      category: 'Finance',
      features: [
        'Account balance access',
        'Transaction history',
        'Spending categorization',
        'Savers jar management',
        'Webhook configuration',
        'Transaction tagging'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up personal access token
upbank auth login --token YOUR_PERSONAL_TOKEN

# Verify connection
upbank auth status`
        },
        {
          title: 'View accounts',
          code: `# List all accounts
upbank accounts list

# Get account details
upbank accounts get ACCOUNT_ID

# View transactions
upbank transactions list \\
  --account-id ACCOUNT_ID \\
  --limit 20`
        }
      ]
    },
    {
      name: 'VAT API',
      slug: 'vatapi-cli',
      package: '@ktmcp-cli/vatapi',
      description: 'European VAT validation and rates',
      longDescription: 'VAT API provides European VAT number validation, rate lookup, and invoice generation services. This CLI lets you validate VAT numbers, retrieve VAT rates by country, convert currencies, and generate VAT-compliant invoices.',
      github: 'https://github.com/ktmcp-cli/vatapi',
      category: 'Finance',
      features: [
        'VAT number validation',
        'EU VAT rate lookup',
        'Invoice generation',
        'Currency conversion',
        'IP geolocation for VAT',
        'Batch VAT validation'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up API key
vatapi auth login --api-key YOUR_API_KEY

# Verify connection
vatapi auth status`
        },
        {
          title: 'Validate VAT',
          code: `# Validate a VAT number
vatapi validate --vat-number GB123456789

# Get VAT rates for a country
vatapi rates get --country-code GB

# Convert currency with VAT
vatapi convert --amount 100 --currency-from GBP --currency-to EUR`
        }
      ]
    },
    {
      name: 'Velo Payments',
      slug: 'velopay-cli',
      package: '@ktmcp-cli/velopay',
      description: 'Mass payout and disbursement API',
      longDescription: 'Velo Payments provides a mass payout platform for businesses that need to send large volumes of payments globally. This CLI lets you manage payees, submit payment batches, track payout status, and manage funding accounts.',
      github: 'https://github.com/ktmcp-cli/velopay',
      category: 'Finance',
      features: [
        'Mass payout submission',
        'Payee management',
        'Payment batch processing',
        'Funding source management',
        'Payment status tracking',
        'Compliance and reporting'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up credentials
velopay auth login --client-id YOUR_ID --client-secret YOUR_SECRET

# Verify connection
velopay auth status`
        },
        {
          title: 'List resources',
          code: `# List payees
velopay payees list

# Submit a payout batch
velopay payouts submit --file ./payouts.csv

# Check payout status
velopay payouts get PAYOUT_ID`
        }
      ]
    },
    {
      name: 'Viator',
      slug: 'viator-cli',
      package: '@ktmcp-cli/viator',
      description: 'Tours and activities booking API',
      longDescription: 'Viator is the world\'s largest marketplace for tours, activities, and experiences. This CLI provides access to product search, availability, booking creation, and booking management for travel experience providers and resellers.',
      github: 'https://github.com/ktmcp-cli/viator',
      category: 'Travel',
      features: [
        'Tour and activity search',
        'Real-time availability',
        'Booking creation',
        'Booking management',
        'Review and rating access',
        'Destination data'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up API key
viator auth login --api-key YOUR_API_KEY

# Verify connection
viator auth status`
        },
        {
          title: 'Search experiences',
          code: `# Search for tours
viator experiences search \\
  --destination "Paris" \\
  --start-date 2026-03-01

# Get experience details
viator experiences get PRODUCT_CODE

# Check availability
viator availability get \\
  --product-code PRODUCT_CODE \\
  --date 2026-03-15`
        }
      ]
    },
    {
      name: 'Vonage SMS',
      slug: 'vonagesms-cli',
      package: '@ktmcp-cli/vonagesms',
      description: 'Send SMS and manage phone numbers',
      longDescription: 'Vonage (formerly Nexmo) SMS API enables businesses to send and receive SMS messages worldwide. This CLI provides access to message sending, inbox management, number provisioning, and delivery receipt handling.',
      github: 'https://github.com/ktmcp-cli/vonagesms',
      category: 'Messaging',
      features: [
        'Send SMS messages',
        'Receive inbound SMS',
        'Phone number management',
        'Delivery receipt tracking',
        'Short code support',
        'Number masking'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up API credentials
vonagesms auth login --api-key YOUR_KEY --api-secret YOUR_SECRET

# Verify connection
vonagesms auth status`
        },
        {
          title: 'Send messages',
          code: `# Send an SMS
vonagesms message send \\
  --to 15550001234 \\
  --from 15559998765 \\
  --text "Hello from Vonage!"

# Check message status
vonagesms message get MESSAGE_ID`
        }
      ]
    },
    {
      name: 'Vonage Voice',
      slug: 'vonagevoice-cli',
      package: '@ktmcp-cli/vonagevoice',
      description: 'Voice calls and PSTN API',
      longDescription: 'Vonage Voice API enables programmatic voice call management including outbound calls, IVR, call recording, and text-to-speech. This CLI lets you create calls, manage active calls, retrieve recordings, and configure voice applications.',
      github: 'https://github.com/ktmcp-cli/vonagevoice',
      category: 'Messaging',
      features: [
        'Outbound voice calls',
        'Call recording',
        'Text-to-speech support',
        'IVR configuration',
        'Call control and management',
        'Transcription access'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up credentials
vonagevoice auth login --api-key YOUR_KEY --api-secret YOUR_SECRET

# Verify connection
vonagevoice auth status`
        },
        {
          title: 'Manage calls',
          code: `# Create an outbound call
vonagevoice calls create \\
  --to 15550001234 \\
  --from 15559998765 \\
  --answer-url https://example.com/ncco.json

# List active calls
vonagevoice calls list`
        }
      ]
    },
    {
      name: 'Yodlee',
      slug: 'yodlee-cli',
      package: '@ktmcp-cli/yodlee',
      description: 'Financial data aggregation API',
      longDescription: 'Yodlee provides financial data aggregation services connecting to thousands of financial institutions. This CLI offers access to accounts, transactions, investment holdings, and net worth data for building personal finance applications.',
      github: 'https://github.com/ktmcp-cli/yodlee',
      category: 'Finance',
      features: [
        'Multi-institution account aggregation',
        'Transaction history access',
        'Investment portfolio data',
        'Net worth calculation',
        'Categorized spending data',
        'Income and expense analysis'
      ],
      examples: [
        {
          title: 'Authentication',
          code: `# Set up credentials
yodlee auth login --client-id YOUR_ID --secret YOUR_SECRET

# Verify connection
yodlee auth status`
        },
        {
          title: 'Access financial data',
          code: `# List all accounts
yodlee accounts list

# Get transactions
yodlee transactions list \\
  --account-id ACCOUNT_ID \\
  --from-date 2026-01-01 \\
  --to-date 2026-01-31

# Get net worth
yodlee derived net-worth`
        }
      ]
    }
  ];

  return clis.map(cli => ({
    params: { cli: cli.slug },
    props: { cli }
  }));
}

const { cli } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>{cli.name} CLI - Kill The MCP</title>
    <meta name="description" content={`${cli.name}: ${cli.description}. Production-ready CLI for ${cli.name} API.`} />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --bg: #0a0a0a;
        --fg: #fafafa;
        --accent: #00ff88;
        --accent-dim: #00aa55;
        --border: #1a1a1a;
        --card-bg: #0f0f0f;
        --text-muted: #a0a0a0;
        --text-dimmed: #666;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem;
      }

      nav {
        padding: 2rem 0;
        border-bottom: 1px solid var(--border);
        margin-bottom: 3rem;
      }

      .nav-link {
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.2s;
        font-size: 0.9rem;
      }

      .nav-link:hover {
        color: var(--accent);
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-dimmed);
      }

      .breadcrumb a {
        color: var(--text-muted);
        text-decoration: none;
      }

      .breadcrumb a:hover {
        color: var(--accent);
      }

      header {
        margin-bottom: 4rem;
      }

      .badge {
        display: inline-block;
        padding: 0.375rem 0.875rem;
        background: var(--accent);
        color: var(--bg);
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1.5rem;
      }

      h1 {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 800;
        margin-bottom: 1rem;
        letter-spacing: -0.03em;
      }

      .package-name {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Courier New', monospace;
        color: var(--text-dimmed);
        font-size: 1rem;
        margin-bottom: 1.5rem;
      }

      .description {
        font-size: 1.25rem;
        color: var(--text-muted);
        line-height: 1.8;
        margin-bottom: 2rem;
      }

      .cta-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.75rem;
        text-decoration: none;
        font-weight: 600;
        border-radius: 10px;
        font-size: 1rem;
        transition: all 0.2s ease;
        border: 2px solid transparent;
      }

      .btn-primary {
        background: var(--accent);
        color: var(--bg);
        box-shadow: 0 4px 24px rgba(0, 255, 136, 0.3);
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(0, 255, 136, 0.4);
      }

      .btn-secondary {
        background: transparent;
        color: var(--fg);
        border-color: var(--border);
      }

      .btn-secondary:hover {
        border-color: var(--accent);
        background: rgba(0, 255, 136, 0.05);
      }

      section {
        margin: 4rem 0;
      }

      h2 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .feature-card {
        padding: 1.5rem;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        transition: all 0.3s ease;
      }

      .feature-card:hover {
        border-color: rgba(0, 255, 136, 0.3);
        transform: translateY(-2px);
      }

      .feature-card::before {
        content: '✓';
        display: inline-block;
        width: 24px;
        height: 24px;
        background: var(--accent);
        color: var(--bg);
        border-radius: 50%;
        text-align: center;
        line-height: 24px;
        font-weight: bold;
        margin-right: 0.75rem;
        font-size: 0.875rem;
      }

      .example {
        margin-bottom: 3rem;
      }

      .example h3 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
        color: var(--accent);
        font-weight: 600;
      }

      pre {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        overflow-x: auto;
        font-size: 0.9rem;
        line-height: 1.6;
      }

      pre code {
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Courier New', monospace;
        color: var(--fg);
      }

      .install-section {
        background: linear-gradient(135deg, rgba(0, 255, 136, 0.05) 0%, rgba(0, 204, 255, 0.05) 100%);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 2rem;
      }

      .install-section h2 {
        margin-bottom: 1rem;
      }

      .install-section p {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
      }

      /* Peter Steinberger quote */
      .quote-block {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-left: 4px solid var(--accent);
        border-radius: 12px;
        padding: 2rem;
        margin: 3rem 0;
        display: flex;
        gap: 2rem;
        align-items: center;
      }

      .quote-block-avatar {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
      }

      .quote-block-avatar img {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        border: 2px solid var(--accent);
        object-fit: cover;
      }

      .openclaw-emoji {
        font-size: 1.75rem;
        line-height: 1;
      }

      .quote-block-content blockquote {
        font-size: 1rem;
        color: var(--text-muted);
        line-height: 1.8;
        font-style: italic;
        margin-bottom: 1rem;
      }

      .quote-block-content blockquote::before {
        content: '"';
        color: var(--accent);
        font-size: 1.5rem;
        line-height: 0;
        vertical-align: -0.4rem;
        margin-right: 0.1rem;
      }

      .quote-block-content blockquote::after {
        content: '"';
        color: var(--accent);
        font-size: 1.5rem;
        line-height: 0;
        vertical-align: -0.4rem;
        margin-left: 0.1rem;
      }

      .quote-block-attribution {
        font-size: 0.85rem;
        color: var(--text-dimmed);
      }

      .quote-block-attribution strong {
        color: var(--accent);
      }

      .quote-block-attribution a {
        color: var(--text-dimmed);
        text-decoration: none;
      }

      .quote-block-attribution a:hover {
        color: var(--accent);
      }

      footer {
        text-align: center;
        padding: 4rem 0 2rem;
        color: var(--text-dimmed);
        border-top: 1px solid var(--border);
        margin-top: 6rem;
      }

      footer a {
        color: var(--accent);
        text-decoration: none;
      }

      footer a:hover {
        color: #00ffaa;
      }

      @media (max-width: 768px) {
        .container {
          padding: 1.5rem;
        }

        .cta-buttons {
          flex-direction: column;
        }

        .btn {
          justify-content: center;
        }

        .quote-block {
          flex-direction: column;
          gap: 1.25rem;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <nav>
        <div class="breadcrumb">
          <a href="/">← Back to home</a>
        </div>
      </nav>

      <header>
        <div class="badge">{cli.category}</div>
        <h1>{cli.name}</h1>
        <div class="package-name">{cli.package}</div>
        <p class="description">{cli.longDescription}</p>
        <div class="cta-buttons">
          <a href={cli.github} class="btn btn-primary">View on GitHub →</a>
          <a href={`https://www.npmjs.com/package/${cli.package}`} class="btn btn-secondary">npm Package</a>
        </div>
      </header>

      <div class="quote-block">
        <div class="quote-block-avatar">
          <img
            src="https://pbs.twimg.com/profile_images/1593545438/steipete_400x400.jpg"
            alt="Peter Steinberger"
            onerror="this.style.display='none'"
          />
          <div class="openclaw-emoji">🦞</div>
        </div>
        <div class="quote-block-content">
          <blockquote>
            Six months ago, everyone was talking about MCPs. And I was like, screw MCPs. Every MCP would be better as a CLI.
          </blockquote>
          <div class="quote-block-attribution">
            <strong>Peter Steinberger</strong>, Founder of OpenClaw ·
            <a href="https://lexfridman.com/peter-steinberger/" target="_blank" rel="noopener">Lex Fridman Podcast #491</a>
            · <a href="https://twitter.com/steipete" target="_blank" rel="noopener">@steipete</a>
          </div>
        </div>
      </div>

      <section class="install-section">
        <h2>Quick Start</h2>
        <p>Install the CLI globally using npm:</p>
        <pre><code>npm install -g {cli.package}</code></pre>
      </section>

      <section>
        <h2>Features</h2>
        <div class="features-grid">
          {cli.features.map(feature => (
            <div class="feature-card">{feature}</div>
          ))}
        </div>
      </section>

      <section>
        <h2>Usage Examples</h2>
        {cli.examples.map(example => (
          <div class="example">
            <h3>{example.title}</h3>
            <pre><code>{example.code}</code></pre>
          </div>
        ))}
      </section>

      <section>
        <h2>Documentation</h2>
        <p style="color: var(--text-muted); line-height: 1.8;">
          For complete documentation, API reference, and advanced usage examples, visit the <a href={cli.github} style="color: var(--accent); text-decoration: none;">GitHub repository</a>.
          Each CLI includes comprehensive README.md, AGENT.md for AI integration, and OPENCLAW.md for tool definitions.
        </p>
      </section>

      <footer>
        <p>Part of the <a href="/">Kill The MCP</a> project</p>
        <p style="margin-top: 1rem;">
          <a href="https://github.com/ktmcp-cli">GitHub</a>
          <span style="color: var(--border); margin: 0 0.5rem;">·</span>
          <a href="https://www.npmjs.com/org/ktmcp-cli">npm</a>
        </p>
      </footer>
    </div>
  </body>
</html>
