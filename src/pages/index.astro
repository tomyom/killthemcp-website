---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>Kill The MCP - Production CLIs for APIs</title>
    <meta name="description" content="Production-ready command-line tools for APIs. No servers, no abstraction layers, just code that works." />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --terminal-black: #000000;
        --terminal-green: #00ff7f;
        --terminal-green-dim: #22d388;
        --terminal-text: #e6edf3;
        --terminal-text-dim: #8b9d9f;
        --terminal-bg: #0a0e0f;
        --terminal-bg-light: #151b1e;
        --glow: 0 0 10px rgba(0, 255, 127, 0.3);
      }

      body {
        font-family: 'Space Mono', 'SF Mono', 'Monaco', monospace;
        background: var(--terminal-black);
        color: var(--terminal-green);
        line-height: 1.6;
        overflow-x: hidden;
      }

      /* CRT scanline effect */
      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          transparent 50%,
          rgba(0, 255, 127, 0.02) 50%
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 9999;
        animation: scan 8s linear infinite;
      }

      @keyframes scan {
        0% { background-position: 0 0; }
        100% { background-position: 0 100%; }
      }

      /* Terminal glow */
      .terminal-glow {
        text-shadow: var(--glow);
      }

      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* Header - terminal style */
      header {
        padding: 1.5rem 0;
        border-bottom: 2px solid var(--terminal-green);
        background: var(--terminal-bg);
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--terminal-green);
        text-decoration: none;
        text-shadow: var(--glow);
      }

      .logo::before {
        content: '> ';
        opacity: 0.7;
      }

      .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
      }

      .nav-links a {
        color: var(--terminal-text);
        text-decoration: none;
        transition: all 0.2s;
      }

      .nav-links a:hover {
        color: var(--terminal-green);
        text-shadow: var(--glow);
      }

      .nav-links a::before {
        content: '$ ';
        opacity: 0.5;
      }

      /* Hero - full terminal */
      .hero {
        padding: 6rem 0 4rem;
        text-align: center;
      }

      .ascii-logo {
        font-size: clamp(0.5rem, 1.2vw, 0.8rem);
        line-height: 1;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 2rem;
        white-space: pre;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .tagline {
        font-size: clamp(1.2rem, 3vw, 1.8rem);
        color: var(--terminal-text);
        margin-bottom: 1rem;
        font-weight: 400;
      }

      .tagline .highlight {
        color: var(--terminal-green);
        text-shadow: var(--glow);
      }

      .description {
        font-size: 1rem;
        color: var(--terminal-text-dim);
        max-width: 600px;
        margin: 0 auto 3rem;
      }

      .description::before {
        content: '';
      }

      .cta-buttons {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        padding: 1rem 2rem;
        border: 2px solid var(--terminal-green);
        background: transparent;
        color: var(--terminal-green);
        text-decoration: none;
        font-family: inherit;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
      }

      .btn::before {
        content: '> ';
      }

      .btn:hover {
        background: var(--terminal-green);
        color: var(--terminal-black);
        box-shadow: var(--glow);
        transform: translateY(-2px);
      }

      .btn-secondary {
        border-color: var(--terminal-text-dim);
        color: var(--terminal-text-dim);
      }

      .btn-secondary:hover {
        background: var(--terminal-text-dim);
        color: var(--terminal-black);
      }

      /* Stats - terminal output style */
      .stats {
        margin: 6rem 0;
        padding: 3rem 2rem;
        background: var(--terminal-bg);
        border: 2px solid var(--terminal-green);
        position: relative;
      }

      .stats::before {
        content: '$ ktmcp --stats';
        position: absolute;
        top: -1.5rem;
        left: 2rem;
        background: var(--terminal-black);
        padding: 0 1rem;
        color: var(--terminal-green-dim);
        font-size: 0.875rem;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 3rem;
      }

      .stat {
        text-align: center;
      }

      .stat-number {
        font-size: 3rem;
        font-weight: 700;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 0.5rem;
      }

      .stat-label {
        color: var(--terminal-text-dim);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
      }

      /* CLI Grid */
      section {
        margin: 6rem 0;
      }

      .section-header {
        margin-bottom: 3rem;
      }

      .section-title {
        font-size: 2rem;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 1rem;
      }

      .section-title::before {
        content: '';
      }

      .section-description {
        color: var(--terminal-text-dim);
        font-size: 0.9rem;
      }

      .section-description::before {
        content: '';
      }

      .cli-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
        gap: 2rem;
      }

      @media (min-width: 1400px) {
        .cli-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .cli-card {
        background: var(--terminal-bg);
        border: 2px solid var(--terminal-green-dim);
        padding: 0;
        text-decoration: none;
        display: block;
        transition: all 0.3s;
        position: relative;
      }

      .cli-card:hover {
        border-color: var(--terminal-green);
        box-shadow: var(--glow);
        transform: translateY(-4px);
      }

      .cli-card::before {
        content: attr(data-package);
        position: absolute;
        top: -1rem;
        left: 1rem;
        background: var(--terminal-black);
        padding: 0 0.5rem;
        color: var(--terminal-green-dim);
        font-size: 0.8rem;
      }

      .terminal-window {
        padding: 1.5rem;
        background: var(--terminal-black);
        border-bottom: 1px solid var(--terminal-green-dim);
        min-height: 220px;
      }

      .terminal-output {
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--terminal-text);
        white-space: pre;
        overflow-x: auto;
      }

      .cli-info {
        padding: 1.5rem;
      }

      .cli-name {
        font-size: 1.25rem;
        color: var(--terminal-green);
        margin-bottom: 0.5rem;
        font-weight: 700;
      }

      .cli-description {
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      /* Why section */
      .why-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }

      .why-item {
        padding: 2rem;
        background: var(--terminal-bg);
        border-left: 4px solid var(--terminal-green);
        transition: all 0.3s;
      }

      .why-item:hover {
        border-color: var(--terminal-green);
        box-shadow: var(--glow);
      }

      .why-item h3 {
        font-size: 1.1rem;
        color: var(--terminal-green);
        margin-bottom: 0.75rem;
      }

      .why-item h3::before {
        content: '> ';
      }

      .why-item p {
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      /* Peter Steinberger quote section */
      .quote-section {
        margin: 6rem 0;
        padding: 3rem;
        background: var(--terminal-bg);
        border: 2px solid var(--terminal-green-dim);
        position: relative;
      }

      .quote-section::before {
        content: '$ echo "the origin story"';
        position: absolute;
        top: -1.5rem;
        left: 2rem;
        background: var(--terminal-black);
        padding: 0 1rem;
        color: var(--terminal-green-dim);
        font-size: 0.875rem;
      }

      .quote-inner {
        display: flex;
        gap: 3rem;
        align-items: center;
      }

      .quote-avatar {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }

      .quote-avatar img {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 2px solid var(--terminal-green);
        object-fit: cover;
        filter: grayscale(20%);
      }

      .openclaw-icon {
        font-size: 2.5rem;
        line-height: 1;
      }

      .quote-content {
        flex: 1;
      }

      .quote-text {
        font-size: 1.1rem;
        color: var(--terminal-text);
        line-height: 1.8;
        margin-bottom: 1.5rem;
        font-style: italic;
      }

      .quote-text::before {
        content: '"';
        color: var(--terminal-green);
        font-size: 2rem;
        line-height: 0;
        vertical-align: -0.5rem;
        margin-right: 0.25rem;
      }

      .quote-text::after {
        content: '"';
        color: var(--terminal-green);
        font-size: 2rem;
        line-height: 0;
        vertical-align: -0.5rem;
        margin-left: 0.25rem;
      }

      .quote-attribution {
        color: var(--terminal-green-dim);
        font-size: 0.85rem;
      }

      .quote-attribution strong {
        color: var(--terminal-green);
      }

      .quote-attribution a {
        color: var(--terminal-green-dim);
        text-decoration: none;
      }

      .quote-attribution a:hover {
        color: var(--terminal-green);
      }

      /* How to use section */
      .how-to-steps {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .how-to-step {
        background: var(--terminal-bg);
        border: 1px solid var(--terminal-green-dim);
        padding: 2rem;
        position: relative;
      }

      .how-to-step::before {
        content: attr(data-step);
        position: absolute;
        top: -1rem;
        left: 1.5rem;
        background: var(--terminal-black);
        padding: 0 0.75rem;
        color: var(--terminal-green);
        font-size: 0.8rem;
        font-weight: 700;
        text-shadow: var(--glow);
      }

      .how-to-step h3 {
        font-size: 1rem;
        color: var(--terminal-green);
        margin-bottom: 0.75rem;
      }

      .how-to-step h3::before {
        content: '$ ';
        opacity: 0.6;
      }

      .how-to-step p {
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
        margin-bottom: 1rem;
      }

      .code-block {
        background: var(--terminal-black);
        border: 1px solid var(--terminal-green-dim);
        border-left: 3px solid var(--terminal-green);
        padding: 1.25rem 1.5rem;
        font-size: 0.85rem;
        line-height: 1.7;
        color: var(--terminal-text);
        white-space: pre;
        overflow-x: auto;
        display: block;
        width: 100%;
      }

      .code-block .comment {
        color: var(--terminal-text-dim);
      }

      .how-to-note {
        margin-top: 1rem;
        color: var(--terminal-text-dim);
        font-size: 0.8rem;
      }

      /* Footer */
      footer {
        margin-top: 8rem;
        padding: 3rem 0 2rem;
        border-top: 2px solid var(--terminal-green);
        background: var(--terminal-bg);
      }

      .footer-content {
        text-align: center;
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      .footer-content::before {
        content: '# ';
        color: var(--terminal-green-dim);
      }

      .footer-links {
        margin-top: 1rem;
        display: flex;
        gap: 2rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--terminal-text-dim);
        text-decoration: none;
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--terminal-green);
      }

      .footer-links a::before {
        content: '$ ';
        opacity: 0.5;
      }

      @media (max-width: 768px) {
        .container {
          padding: 0 1rem;
        }

        /* Hide ASCII art on mobile, replace with simple text */
        .ascii-logo {
          display: none;
        }

        .hero::before {
          content: 'KTMCP';
          display: block;
          font-size: 3rem;
          font-weight: 900;
          color: var(--terminal-green);
          text-shadow: var(--glow);
          margin-bottom: 1rem;
        }

        .hero {
          padding: 3rem 0 2rem;
        }

        .tagline {
          font-size: 1.5rem;
        }

        .description {
          font-size: 0.9rem;
        }

        .cta-buttons {
          flex-direction: column;
          gap: 1rem;
        }

        .btn {
          width: 100%;
          justify-content: center;
          text-align: center;
        }

        /* Stats on mobile */
        .stats {
          margin: 3rem 0 4rem;
          padding: 2rem 1rem;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 2rem;
        }

        .stat-number {
          font-size: 2rem;
        }

        .stat-label {
          font-size: 0.65rem;
        }

        /* Section spacing */
        section {
          margin: 4rem 0;
        }

        .section-title {
          font-size: 1.5rem;
        }

        .section-description {
          font-size: 0.85rem;
        }

        /* How to use on mobile */
        .how-to-step {
          padding: 1.5rem;
        }

        .code-block {
          font-size: 0.75rem;
          padding: 1rem;
        }

        /* CLI cards on mobile */
        .cli-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .cli-card {
          font-size: 0.9rem;
        }

        .cli-card::before {
          font-size: 0.7rem;
        }

        .terminal-window {
          padding: 1rem;
          min-height: 180px;
        }

        .terminal-output {
          font-size: 0.7rem;
        }

        .cli-name {
          font-size: 1.1rem;
        }

        /* Why grid on mobile */
        .why-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .why-item {
          padding: 1.5rem;
        }

        .why-item h3 {
          font-size: 1rem;
        }

        .why-item p {
          font-size: 0.8rem;
        }

        /* Quote section on mobile */
        .quote-section {
          padding: 2rem 1.5rem;
          margin: 4rem 0;
        }

        .quote-inner {
          flex-direction: column;
          gap: 1.5rem;
          text-align: center;
        }

        .quote-text {
          font-size: 0.95rem;
        }

        /* Navigation on mobile */
        nav {
          font-size: 0.85rem;
        }

        .logo {
          font-size: 1.25rem;
        }

        .nav-links {
          gap: 1rem;
        }

        .nav-links a {
          font-size: 0.8rem;
        }

        /* Footer on mobile */
        footer {
          margin-top: 4rem;
          padding: 2rem 0 1.5rem;
        }

        .footer-content {
          font-size: 0.75rem;
        }

        .footer-links {
          font-size: 0.8rem;
          gap: 1.5rem;
        }
      }

      /* Tablet breakpoint */
      @media (min-width: 769px) and (max-width: 1024px) {
        .ascii-logo {
          font-size: 0.6rem;
        }

        .cli-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .why-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a href="/" class="logo">KTMCP</a>
          <div class="nav-links">
            <a href="#clis">clis</a>
            <a href="https://github.com/ktmcp-cli">github</a>
            <a href="https://www.npmjs.com/org/ktmcp-cli">npm</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <section class="hero">
          <pre class="ascii-logo">
