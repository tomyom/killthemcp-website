              <div class="cli-name">{cli.name}</div>
              <div class="cli-package">{cli.package}</div>
              <div class="cli-description">{cli.description}</div>
              <div class="cli-links">
                <a href={cli.github} class="cli-link">GitHub</a>
                <a href={`https://www.npmjs.com/package/${cli.package}`} class="cli-link">npm</a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section style="margin: 4rem 0;">
        <h2>Quick Start</h2>
        <pre><code># Install any CLI
npm install -g @ktmcp-cli/nordigen

# Authenticate
nordigen auth login --secret-id YOUR_ID --secret-key YOUR_KEY

# Use it
nordigen institutions list --country GB
nordigen accounts list COMPANY_ID --format json

# Pipe and compose
nordigen accounts transactions ACCOUNT_ID | jq '.transactions[] | select(.amount > 1000)'</code></pre>
      </section>

