    slug: 'yodlee-cli',
    package: '@ktmcp-cli/yodlee',
    description: 'Financial data aggregation API',
    github: 'https://github.com/ktmcp-cli/yodlee',
    category: 'Finance',
    terminalExample: `$ yodlee accounts list

✓ Aggregated accounts (4)
Chase Checking   $5,200.00
Vanguard 401k    $88,400.00
Amex Platinum    -$1,240.00`
  }
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kill The MCP - Production CLIs for APIs</title>
    <meta name="description" content="Production-ready command-line tools for APIs. No servers, no abstraction layers, just code that works." />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --terminal-black: #000000;
        --terminal-green: #00ff7f;
        --terminal-green-dim: #22d388;
        --terminal-text: #e6edf3;
        --terminal-text-dim: #8b9d9f;
        --terminal-bg: #0a0e0f;
        --terminal-bg-light: #151b1e;
        --glow: 0 0 10px rgba(0, 255, 127, 0.3);
      }

      body {
        font-family: 'Space Mono', 'SF Mono', 'Monaco', monospace;
        background: var(--terminal-black);
        color: var(--terminal-green);
        line-height: 1.6;
        overflow-x: hidden;
        max-width: 100vw;
      }

      /* CRT scanline effect */
      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          transparent 50%,
          rgba(0, 255, 127, 0.02) 50%
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 9999;
        animation: scan 8s linear infinite;
      }

      @keyframes scan {
        0% { background-position: 0 0; }
        100% { background-position: 0 100%; }
      }

      /* Terminal glow */
      .terminal-glow {
        text-shadow: var(--glow);
      }

      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* Header - terminal style */
      header {
        padding: 1.5rem 0;
        border-bottom: 2px solid var(--terminal-green);
        background: var(--terminal-bg);
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--terminal-green);
        text-decoration: none;
        text-shadow: var(--glow);
      }

      .logo::before {
        content: '> ';
        opacity: 0.7;
      }

      .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
      }

      .nav-links a {
        color: var(--terminal-text);
        text-decoration: none;
        transition: all 0.2s;
      }

      .nav-links a:hover {
        color: var(--terminal-green);
        text-shadow: var(--glow);
      }

      .nav-links a::before {
        content: '$ ';
        opacity: 0.5;
      }

      /* Hero - full terminal */
      .hero {
        padding: 6rem 0 4rem;
        text-align: center;
      }

      .ascii-logo {
        font-size: clamp(0.5rem, 1.2vw, 1.1rem);
        line-height: 1;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 2rem;
        white-space: pre;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .tagline {
        font-size: clamp(1.2rem, 3vw, 1.8rem);
        color: var(--terminal-text);
        margin-bottom: 1rem;
        font-weight: 400;
      }

      .tagline .highlight {
        color: var(--terminal-green);
        text-shadow: var(--glow);
      }

      .description {
        font-size: 1rem;
        color: var(--terminal-text-dim);
        max-width: 600px;
        margin: 0 auto 3rem;
      }

      .description::before {
        content: '';
      }

      .cta-buttons {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        padding: 1rem 2rem;
        border: 2px solid var(--terminal-green);
        background: transparent;
        color: var(--terminal-green);
        text-decoration: none;
        font-family: inherit;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
      }

      .btn::before {
        content: '> ';
      }

      .btn:hover {
        background: var(--terminal-green);
        color: var(--terminal-black);
        box-shadow: var(--glow);
        transform: translateY(-2px);
      }

      .btn-secondary {
        border-color: var(--terminal-text-dim);
        color: var(--terminal-text-dim);
      }

      .btn-secondary:hover {
        background: var(--terminal-text-dim);
        color: var(--terminal-black);
      }

      /* Stats - terminal output style */
      .stats {
        margin: 6rem 0;
        padding: 3rem 2rem;
        background: var(--terminal-bg);
        border: 2px solid var(--terminal-green);
        position: relative;
      }

      .stats::before {
        content: '$ ktmcp --stats';
        position: absolute;
        top: -1.5rem;
        left: 2rem;
        background: var(--terminal-black);
        padding: 0 1rem;
        color: var(--terminal-green-dim);
        font-size: 0.875rem;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 3rem;
      }

      .stat {
        text-align: center;
      }

      .stat-number {
        font-size: 3rem;
        font-weight: 700;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 0.5rem;
      }

      .stat-label {
        color: var(--terminal-text-dim);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
      }

      /* CLI Grid */
      section {
        margin: 6rem 0;
      }

      .section-header {
        margin-bottom: 3rem;
      }

      .section-title {
        font-size: 2rem;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 1rem;
      }

      .section-title::before {
        content: '';
      }

      .section-description {
        color: var(--terminal-text-dim);
        font-size: 0.9rem;
      }

      .section-description::before {
        content: '';
      }

      .cli-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
        gap: 2rem;
      }

      .cli-card {
        background: var(--terminal-bg);
        border: 2px solid var(--terminal-green-dim);
        padding: 0;
        text-decoration: none;
        display: block;
        transition: all 0.3s;
        position: relative;
        min-width: 0;
      }

      .cli-card:hover {
        border-color: var(--terminal-green);
        box-shadow: var(--glow);
        transform: translateY(-4px);
      }

      .cli-card::before {
        content: attr(data-package);
        position: absolute;
        top: -1rem;
        left: 1rem;
        background: var(--terminal-black);
        padding: 0 0.5rem;
        color: var(--terminal-green-dim);
        font-size: 0.8rem;
      }

      .terminal-window {
        padding: 1.5rem;
        background: var(--terminal-black);
        border-bottom: 1px solid var(--terminal-green-dim);
        min-height: 220px;
        min-width: 0;
        overflow: hidden;
      }

      .terminal-output {
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--terminal-text);
        white-space: pre;
        overflow-x: auto;
      }

      .cli-info {
        padding: 1.5rem;
      }

      .cli-name {
        font-size: 1.25rem;
        color: var(--terminal-green);
        margin-bottom: 0.5rem;
        font-weight: 700;
      }

      .cli-description {
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      /* Why section */
      .why-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }

      @media (min-width: 1400px) {
        .cli-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .why-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .why-item {
        padding: 2rem;
        background: var(--terminal-bg);
        border-left: 4px solid var(--terminal-green);
        transition: all 0.3s;
      }

      .why-item:hover {
        border-color: var(--terminal-green);
        box-shadow: var(--glow);
      }

      .why-item h3 {
        font-size: 1.1rem;
        color: var(--terminal-green);
        margin-bottom: 0.75rem;
      }

      .why-item h3::before {
        content: '> ';
      }

      .why-item p {
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      /* Peter Steinberger quote section */
      .quote-section {
        margin: 6rem 0;
        padding: 3rem;
        background: var(--terminal-bg);
        border: 2px solid var(--terminal-green-dim);
        position: relative;
      }

      .quote-section::before {
        content: '$ echo "the origin story"';
        position: absolute;
        top: -1.5rem;
        left: 2rem;
        background: var(--terminal-black);
        padding: 0 1rem;
        color: var(--terminal-green-dim);
        font-size: 0.875rem;
      }

      .quote-inner {
        display: flex;
        gap: 3rem;
        align-items: center;
      }

      .quote-avatar {
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
      }

      .quote-avatar img {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 2px solid var(--terminal-green);
        object-fit: cover;
        filter: grayscale(20%);
      }

      .openclaw-icon {
        font-size: 2.5rem;
        line-height: 1;
      }

      .quote-content {
        flex: 1;
      }

      .quote-text {
        font-size: 1.1rem;
        color: var(--terminal-text);
        line-height: 1.8;
        margin-bottom: 1.5rem;
        font-style: italic;
      }

      .quote-text::before {
        content: '"';
        color: var(--terminal-green);
        font-size: 2rem;
        line-height: 0;
        vertical-align: -0.5rem;
        margin-right: 0.25rem;
      }

      .quote-text::after {
        content: '"';
        color: var(--terminal-green);
        font-size: 2rem;
        line-height: 0;
        vertical-align: -0.5rem;
        margin-left: 0.25rem;
      }

      .quote-attribution {
        color: var(--terminal-green-dim);
        font-size: 0.85rem;
      }

      .quote-attribution strong {
        color: var(--terminal-green);
      }

      .quote-attribution a {
        color: var(--terminal-green-dim);
        text-decoration: none;
      }

      .quote-attribution a:hover {
        color: var(--terminal-green);
      }

      /* How to use section */
      .how-to-steps {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .how-to-step {
        background: var(--terminal-bg);
        border: 1px solid var(--terminal-green-dim);
        padding: 2rem;
        position: relative;
      }

      .how-to-step::before {
        content: attr(data-step);
        position: absolute;
        top: -1rem;
        left: 1.5rem;
        background: var(--terminal-black);
        padding: 0 0.75rem;
        color: var(--terminal-green);
        font-size: 0.8rem;
        font-weight: 700;
        text-shadow: var(--glow);
      }

      .how-to-step h3 {
        font-size: 1rem;
        color: var(--terminal-green);
        margin-bottom: 0.75rem;
      }

      .how-to-step h3::before {
        content: '$ ';
        opacity: 0.6;
      }

      .how-to-step p {
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
        margin-bottom: 1rem;
      }

      .code-block {
        background: var(--terminal-black);
        border: 1px solid var(--terminal-green-dim);
        border-left: 3px solid var(--terminal-green);
        padding: 1.25rem 1.5rem;
        font-size: 0.85rem;
        line-height: 1.7;
        color: var(--terminal-text);
        white-space: pre;
        overflow-x: auto;
        display: block;
        width: 100%;
      }

      .code-block .comment {
        color: var(--terminal-text-dim);
      }

      .how-to-note {
        margin-top: 1rem;
        color: var(--terminal-text-dim);
        font-size: 0.8rem;
      }

      /* Footer */
      footer {
        margin-top: 8rem;
        padding: 3rem 0 2rem;
        border-top: 2px solid var(--terminal-green);
        background: var(--terminal-bg);
      }

      .footer-content {
        text-align: center;
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      .footer-content::before {
        content: '# ';
        color: var(--terminal-green-dim);
      }

      .footer-links {
        margin-top: 1rem;
        display: flex;
        gap: 2rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--terminal-text-dim);
        text-decoration: none;
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--terminal-green);
      }

      .footer-links a::before {
        content: '$ ';
        opacity: 0.5;
      }

      @media (max-width: 768px) {
        .container {
          padding: 0 1rem;
        }

        /* Hide ASCII art on mobile, replace with simple text */
        .ascii-logo {
          display: none;
        }

        .hero::before {
          content: 'KTMCP';
          display: block;
          font-size: 3rem;
          font-weight: 900;
          color: var(--terminal-green);
          text-shadow: var(--glow);
          margin-bottom: 1rem;
        }

        .hero {
          padding: 3rem 0 2rem;
        }

        .tagline {
          font-size: 1.5rem;
        }

        .description {
          font-size: 0.9rem;
        }

        .cta-buttons {
          flex-direction: column;
          gap: 1rem;
        }

        .btn {
          width: 100%;
          justify-content: center;
          text-align: center;
        }

        /* Stats on mobile */
        .stats {
          margin: 3rem 0 4rem;
          padding: 2.5rem 1rem 1.5rem;
        }

        .stats::before {
          left: 0.5rem;
          font-size: 0.7rem;
          top: -1.1rem;
          max-width: calc(100% - 1rem);
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 1.5rem;
        }

        .stat-number {
          font-size: 1.75rem;
        }

        .stat-label {
          font-size: 0.6rem;
          letter-spacing: 0.1em;
        }

        /* Section spacing */
        section {
          margin: 4rem 0;
        }

        .section-title {
          font-size: 1.5rem;
        }

        .section-description {
          font-size: 0.85rem;
        }

        /* How to use on mobile */
        .how-to-step {
          padding: 1.5rem 1rem;
        }

        .how-to-step::before {
          left: 0.75rem;
          font-size: 0.72rem;
          max-width: calc(100% - 1.5rem);
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .code-block {
          font-size: 0.72rem;
          padding: 1rem;
          white-space: pre;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          max-width: 100%;
          word-break: normal;
        }

        /* CLI cards on mobile */
        .cli-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .cli-card {
          font-size: 0.9rem;
        }

        .cli-card::before {
          font-size: 0.7rem;
          max-width: calc(100% - 2rem);
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .terminal-window {
          padding: 1rem;
          min-height: 160px;
          overflow: hidden;
        }

        .terminal-output {
          font-size: 0.65rem;
          white-space: pre;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          max-width: 100%;
          display: block;
        }

        .cli-name {
          font-size: 1.1rem;
        }

        /* Why grid on mobile */
        .why-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .why-item {
          padding: 1.5rem;
        }

        .why-item h3 {
          font-size: 1rem;
        }

        .why-item p {
          font-size: 0.8rem;
        }

        /* Quote section on mobile */
        .quote-section {
          padding: 2rem 1rem;
          margin: 4rem 0;
        }

        .quote-section::before {
          left: 0.5rem;
          font-size: 0.75rem;
          max-width: calc(100% - 1rem);
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .quote-inner {
          flex-direction: column;
          gap: 1.5rem;
          text-align: left;
        }

        .quote-text {
          font-size: 1rem;
          font-family: Georgia, 'Times New Roman', serif;
          font-style: italic;
          line-height: 1.7;
          word-break: normal;
          overflow-wrap: break-word;
        }

        .quote-text::before,
        .quote-text::after {
          font-family: Georgia, 'Times New Roman', serif;
        }

        /* Navigation on mobile */
        nav {
          font-size: 0.85rem;
          gap: 0.5rem;
        }

        .logo {
          font-size: 1.1rem;
          flex-shrink: 0;
        }

        .nav-links {
          gap: 0.75rem;
          flex-shrink: 0;
        }

        .nav-links a {
          font-size: 0.75rem;
        }

        /* Footer on mobile */
        footer {
          margin-top: 4rem;
          padding: 2rem 0 1.5rem;
        }

        .footer-content {
          font-size: 0.75rem;
        }

        .footer-links {
          font-size: 0.8rem;
          gap: 1.5rem;
        }
      }

      /* Extra small screens (≤400px) */
      @media (max-width: 400px) {
        .nav-links a::before {
          content: '';
        }

        .nav-links a {
          font-size: 0.72rem;
        }

        .logo {
          font-size: 1rem;
        }
      }

      /* Tablet breakpoint */
      @media (min-width: 769px) and (max-width: 1024px) {
        .ascii-logo {
          font-size: 0.6rem;
        }

        .cli-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .why-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a href="/" class="logo">KTMCP</a>
          <div class="nav-links">
            <a href="#clis">clis</a>
            <a href="https://github.com/ktmcp-cli">github</a>
            <a href="https://www.npmjs.com/org/ktmcp-cli">npm</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <section class="hero">
          <pre class="ascii-logo">
██╗  ██╗████████╗███╗   ███╗ ██████╗██████╗
██║ ██╔╝╚══██╔══╝████╗ ████║██╔════╝██╔══██╗
█████╔╝    ██║   ██╔████╔██║██║     ██████╔╝
██╔═██╗    ██║   ██║╚██╔╝██║██║     ██╔═══╝
██║  ██╗   ██║   ██║ ╚═╝ ██║╚██████╗██║
╚═╝  ╚═╝   ╚═╝   ╚═╝     ╚═╝ ╚═════╝╚═╝
          </pre>

          <h1 class="tagline">
            <span class="highlight">Kill The MCP.</span> Use CLIs.
          </h1>

          <p class="description">
            MCPs should've just been CLIs with good docs so your AI could easily connect to any 3rd party API. We're fixing that.
          </p>

          <div class="cta-buttons">
            <a href="https://www.npmjs.com/org/ktmcp-cli" class="btn">Browse CLIs</a>
            <a href="https://github.com/ktmcp-cli" class="btn btn-secondary">GitHub</a>
          </div>
        </section>

        <div class="quote-section">
          <div class="quote-inner">
            <div class="quote-avatar">
              <img
                src="https://pbs.twimg.com/profile_images/1593545438/steipete_400x400.jpg"
                alt="Peter Steinberger"
                onerror="this.style.display='none'"
              />
              <div class="openclaw-icon">🦞</div>
            </div>
            <div class="quote-content">
              <p class="quote-text">
                Six months ago, everyone was talking about MCPs. And I was like, screw MCPs. Every MCP would be better as a CLI.
              </p>
              <div class="quote-attribution">
                <strong>Peter Steinberger</strong>, Founder of OpenClaw<br />
                <a href="https://lexfridman.com/peter-steinberger/" target="_blank" rel="noopener">Lex Fridman Podcast #491</a>
                · <a href="https://twitter.com/steipete" target="_blank" rel="noopener">@steipete</a>
              </div>
            </div>
          </div>
        </div>

        <div class="stats">
          <div class="stats-grid">
            <div class="stat">
              <div class="stat-number">{clis.length}</div>
              <div class="stat-label">CLIs Published</div>
            </div>
            <div class="stat">
              <div class="stat-number">3/hr</div>
              <div class="stat-label">Release Pace</div>
            </div>
            <div class="stat">
              <div class="stat-number">1,000</div>
              <div class="stat-label">Goal</div>
            </div>
            <div class="stat">
              <div class="stat-number">MIT</div>
              <div class="stat-label">License</div>
            </div>
          </div>
        </div>

        <section id="how-to-use">
          <div class="section-header">
            <h2 class="section-title">How to use</h2>
            <p class="section-description">
              So you've decided MCPs are unnecessary BS. We're with you. Here's what you need to get started.
            </p>
          </div>

          <div class="how-to-steps">
            <div class="how-to-step" data-step="// step 1 — add the skill">
              <h3>Add KTMCP to your agent</h3>
              <p>Copy this into your agent's SKILL.md, system prompt, or <code style="color: var(--terminal-green); font-size: 0.85rem;">~/.claude/CLAUDE.md</code>:</p>
              <pre class="code-block"><span class="comment"># KTMCP — CLI tools for APIs (no MCP servers needed)</span>

You have access to ktmcp CLIs — lightweight command-line tools for popular APIs.
Instead of spinning up MCP servers, use these CLIs directly via bash.

<span class="comment">## Finding CLIs</span>
Browse: https://killthemcp.com/llms.txt
npm:    https://npmjs.com/org/ktmcp-cli
GitHub: https://github.com/ktmcp-cli

<span class="comment">## Using a CLI</span>
npm install -g @ktmcp-cli/&#123;name&#125;   <span class="comment"># install once</span>
&#123;name&#125; --help                          <span class="comment"># list commands</span>
&#123;name&#125; &#123;resource&#125; list               <span class="comment"># always returns JSON</span>

<span class="comment">## Example</span>
npm install -g @ktmcp-cli/stripe
stripe payments list
stripe customers get --id cus_abc123</pre>
            </div>

            <div class="how-to-step" data-step="// step 2 — point to llms.txt">
              <h3>Reference the full catalog</h3>
              <p>Point your agent at <a href="/llms.txt" style="color: var(--terminal-green); text-decoration: none;">killthemcp.com/llms.txt</a> — a machine-readable index of every available CLI, updated automatically as new ones ship:</p>
              <pre class="code-block">https://killthemcp.com/llms.txt</pre>
              <p class="how-to-note">Works with any LLM that supports URL context — Claude Projects, ChatGPT file uploads, Cursor rules, etc.</p>
            </div>

            <div class="how-to-step" data-step="// step 3 — find the right CLI">
              <h3>Find a CLI for any API</h3>
              <pre class="code-block"><span class="comment"># Search npm directly</span>
npm search @ktmcp-cli

<span class="comment"># Or ask your agent</span>
"Check killthemcp.com/llms.txt — is there a CLI for [service]?"

<span class="comment"># Or browse GitHub</span>
https://github.com/ktmcp-cli</pre>
              <p class="how-to-note">New CLIs ship every hour. If yours isn't here yet, <a href="https://github.com/ktmcp-cli" style="color: var(--terminal-green-dim); text-decoration: none;">open an issue</a>.</p>
            </div>
          </div>
        </section>

        <section id="clis">
          <div class="section-header">
            <h2 class="section-title">Available CLIs</h2>
            <p class="section-description">
              Finance APIs to start — Xero, Stripe, QuickBooks, and more. Growing daily.
            </p>
          </div>

          <div class="cli-grid">
            {clis.map(cli => (
              <a
                href={`/${cli.slug}`}
                class="cli-card"
                data-package={cli.package}
              >
                <div class="terminal-window">
                  <pre class="terminal-output">{cli.terminalExample}</pre>
                </div>
                <div class="cli-info">
                  <div class="cli-name">{cli.name}</div>
                  <div class="cli-description">{cli.description}</div>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section>
          <div class="section-header">
            <h2 class="section-title">Why CLI over MCP?</h2>
            <p class="section-description">
              Direct API access beats abstraction layers.
            </p>
          </div>

          <div class="why-grid">
            <div class="why-item">
              <h3>Faster</h3>
              <p>Direct API calls. No server overhead. No protocol parsing.</p>
            </div>
            <div class="why-item">
              <h3>Cheaper</h3>
              <p>Zero hosting. Zero per-request fees. Just your API bill.</p>
            </div>
            <div class="why-item">
              <h3>Simpler</h3>
              <p>Standard Unix. Pipe, redirect, compose. You know this.</p>
            </div>
            <div class="why-item">
              <h3>Deterministic</h3>
              <p>Same input, same output. Every time. No surprises.</p>
            </div>
            <div class="why-item">
              <h3>Debuggable</h3>
              <p>See what's happening. Read the code. No black boxes.</p>
            </div>
            <div class="why-item">
              <h3>Portable</h3>
              <p>Got Node.js? You're done. No containers. No setup.</p>
            </div>
          </div>
        </section>
      </div>
    </main>

    <footer>
