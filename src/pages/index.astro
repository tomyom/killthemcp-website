        font-size: 0.9rem;
        margin-bottom: 1rem;
      }

      .cli-description {
        color: #ccc;
        margin-bottom: 1.5rem;
      }

      .cli-links {
        display: flex;
        gap: 1rem;
      }

      .cli-link {
        padding: 0.5rem 1rem;
        background: var(--border);
        color: var(--fg);
        text-decoration: none;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: background 0.2s;
      }

      .cli-link:hover {
        background: var(--accent-dim);
        color: var(--bg);
      }

      .why-section {
        background: var(--card-bg);
        border: 2px solid var(--accent);
