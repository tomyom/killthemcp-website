---
const clis = [
  {
    name: 'Billingo',
    slug: 'billingo',
    package: '@ktmcp-cli/billingo',
    description: 'Hungarian invoicing and billing automation',
    github: 'https://github.com/ktmcp-cli/billingo',
    category: 'Finance',
    terminalExample: `$ billingo invoices list --limit 5

✓ Found 23 invoices
┌───────┬──────────────┬────────────┬──────────┐
│ ID    │ Client       │ Amount     │ Status   │
├───────┼──────────────┼────────────┼──────────┤
│ 12345 │ Acme Corp    │ 1,250 EUR  │ paid     │
│ 12344 │ Tech Ltd     │ 890 EUR    │ pending  │
└───────┴──────────────┴────────────┴──────────┘`
  },
  {
    name: 'NOWPayments',
    slug: 'nowpayments',
    package: '@ktmcp-cli/nowpayments',
    description: 'Cryptocurrency payment processing',
    github: 'https://github.com/ktmcp-cli/nowpayments',
    category: 'Finance',
    terminalExample: `$ nowpayments payment create \\
  --amount 100 --currency BTC

✓ Payment created successfully
{
  "payment_id": "5234523482",
  "amount": 0.00234 BTC,
  "address": "bc1q...xyz"
}`
  },
  {
    name: 'Nordigen',
    slug: 'nordigen',
    package: '@ktmcp-cli/nordigen',
    description: 'Open banking across 2500+ institutions',
    github: 'https://github.com/ktmcp-cli/nordigen',
    category: 'Finance',
    terminalExample: `$ nordigen accounts list

✓ Connected accounts (3)

HSBC UK | €12,456.78
└─ **** **** **** 1234

Revolut | €8,932.45
└─ **** **** **** 5678`
  },
  {
    name: 'Klarna',
    slug: 'klarna',
    package: '@ktmcp-cli/klarna',
    description: 'Buy now, pay later integration',
    github: 'https://github.com/ktmcp-cli/klarna',
    category: 'Finance',
    terminalExample: `$ klarna order create \\
  --amount 12999 \\
  --currency SEK

✓ Order created
Session ID: a1b2c3d4-e5f6
Redirect: https://klarna.com/...`
  },
  {
    name: 'Codat',
    slug: 'codat',
    package: '@ktmcp-cli/codat',
    description: 'Unified accounting from 20+ platforms',
    github: 'https://github.com/ktmcp-cli/codat',
    category: 'Finance',
    terminalExample: `$ codat companies list --platform xero

✓ Found 12 companies

Acme Corp (UK)
├─ Platform: Xero
├─ Status: Linked
└─ Last sync: 2 hours ago`
  }
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>Kill The MCP - Production CLIs for APIs</title>
    <meta name="description" content="Production-ready command-line tools for APIs. No servers, no abstraction layers, just code that works." />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --terminal-black: #000000;
        --terminal-green: #00ff7f;
        --terminal-green-dim: #22d388;
        --terminal-text: #e6edf3;
        --terminal-text-dim: #8b9d9f;
        --terminal-bg: #0a0e0f;
        --terminal-bg-light: #151b1e;
        --glow: 0 0 10px rgba(0, 255, 127, 0.3);
      }

      body {
        font-family: 'Space Mono', 'SF Mono', 'Monaco', monospace;
        background: var(--terminal-black);
        color: var(--terminal-green);
        line-height: 1.6;
        overflow-x: hidden;
      }

      /* CRT scanline effect */
      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          transparent 50%,
          rgba(0, 255, 127, 0.02) 50%
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 9999;
        animation: scan 8s linear infinite;
      }

      @keyframes scan {
        0% { background-position: 0 0; }
        100% { background-position: 0 100%; }
      }

      /* Terminal glow */
      .terminal-glow {
        text-shadow: var(--glow);
      }

      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* Header - terminal style */
      header {
        padding: 1.5rem 0;
        border-bottom: 2px solid var(--terminal-green);
        background: var(--terminal-bg);
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--terminal-green);
        text-decoration: none;
        text-shadow: var(--glow);
      }

      .logo::before {
        content: '> ';
        opacity: 0.7;
      }

      .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
      }

      .nav-links a {
        color: var(--terminal-text);
        text-decoration: none;
        transition: all 0.2s;
      }

      .nav-links a:hover {
        color: var(--terminal-green);
        text-shadow: var(--glow);
      }

      .nav-links a::before {
        content: '$ ';
        opacity: 0.5;
      }

      /* Hero - full terminal */
      .hero {
        padding: 6rem 0 4rem;
        text-align: center;
      }

      .ascii-logo {
        font-size: clamp(0.5rem, 1.2vw, 0.8rem);
        line-height: 1;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 2rem;
        white-space: pre;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .tagline {
        font-size: clamp(1.2rem, 3vw, 1.8rem);
        color: var(--terminal-text);
        margin-bottom: 1rem;
        font-weight: 400;
      }

      .tagline .highlight {
        color: var(--terminal-green);
        text-shadow: var(--glow);
      }

      .description {
        font-size: 1rem;
        color: var(--terminal-text-dim);
        max-width: 600px;
        margin: 0 auto 3rem;
      }

      .description::before {
        content: '';
      }

      .cta-buttons {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        padding: 1rem 2rem;
        border: 2px solid var(--terminal-green);
        background: transparent;
        color: var(--terminal-green);
        text-decoration: none;
        font-family: inherit;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
      }

      .btn::before {
        content: '> ';
      }

      .btn:hover {
        background: var(--terminal-green);
        color: var(--terminal-black);
        box-shadow: var(--glow);
        transform: translateY(-2px);
      }

      .btn-secondary {
        border-color: var(--terminal-text-dim);
        color: var(--terminal-text-dim);
      }

      .btn-secondary:hover {
        background: var(--terminal-text-dim);
        color: var(--terminal-black);
      }

      /* Stats - terminal output style */
      .stats {
        margin: 6rem 0;
        padding: 3rem 2rem;
        background: var(--terminal-bg);
        border: 2px solid var(--terminal-green);
        position: relative;
      }

      .stats::before {
        content: '$ ktmcp --stats';
        position: absolute;
        top: -1.5rem;
        left: 2rem;
        background: var(--terminal-black);
        padding: 0 1rem;
        color: var(--terminal-green-dim);
        font-size: 0.875rem;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 3rem;
      }

      .stat {
        text-align: center;
      }

      .stat-number {
        font-size: 3rem;
        font-weight: 700;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 0.5rem;
      }

      .stat-label {
        color: var(--terminal-text-dim);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
      }

      /* CLI Grid */
      section {
        margin: 6rem 0;
      }

      .section-header {
        margin-bottom: 3rem;
      }

      .section-title {
        font-size: 2rem;
        color: var(--terminal-green);
        text-shadow: var(--glow);
        margin-bottom: 1rem;
      }

      .section-title::before {
        content: '';
      }

      .section-description {
        color: var(--terminal-text-dim);
        font-size: 0.9rem;
      }

      .section-description::before {
        content: '';
      }

      .cli-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 2rem;
      }

      .cli-card {
        background: var(--terminal-bg);
        border: 2px solid var(--terminal-green-dim);
        padding: 0;
        text-decoration: none;
        display: block;
        transition: all 0.3s;
        position: relative;
      }

      .cli-card:hover {
        border-color: var(--terminal-green);
        box-shadow: var(--glow);
        transform: translateY(-4px);
      }

      .cli-card::before {
        content: attr(data-package);
        position: absolute;
        top: -1rem;
        left: 1rem;
        background: var(--terminal-black);
        padding: 0 0.5rem;
        color: var(--terminal-green-dim);
        font-size: 0.75rem;
      }

      .terminal-window {
        padding: 1.5rem;
        background: var(--terminal-black);
        border-bottom: 1px solid var(--terminal-green-dim);
        min-height: 240px;
      }

      .terminal-output {
        font-size: 0.75rem;
        line-height: 1.5;
        color: var(--terminal-text);
        white-space: pre;
        overflow-x: auto;
      }

      .cli-info {
        padding: 1.5rem;
      }

      .cli-name {
        font-size: 1.25rem;
        color: var(--terminal-green);
        margin-bottom: 0.5rem;
        font-weight: 700;
      }

      .cli-description {
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      /* Why section */
      .why-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }

      .why-item {
        padding: 2rem;
        background: var(--terminal-bg);
        border-left: 4px solid var(--terminal-green);
        transition: all 0.3s;
      }

      .why-item:hover {
        border-color: var(--terminal-green);
        box-shadow: var(--glow);
      }

      .why-item h3 {
        font-size: 1.1rem;
        color: var(--terminal-green);
        margin-bottom: 0.75rem;
      }

      .why-item h3::before {
        content: '> ';
      }

      .why-item p {
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      /* Footer */
      footer {
        margin-top: 8rem;
        padding: 3rem 0 2rem;
        border-top: 2px solid var(--terminal-green);
        background: var(--terminal-bg);
      }

      .footer-content {
        text-align: center;
        color: var(--terminal-text-dim);
        font-size: 0.85rem;
      }

      .footer-content::before {
        content: '# ';
        color: var(--terminal-green-dim);
      }

      .footer-links {
        margin-top: 1rem;
        display: flex;
        gap: 2rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--terminal-text-dim);
        text-decoration: none;
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--terminal-green);
      }

      .footer-links a::before {
        content: '$ ';
        opacity: 0.5;
      }

      @media (max-width: 768px) {
        .container {
          padding: 0 1rem;
        }

        /* Hide ASCII art on mobile, replace with simple text */
        .ascii-logo {
          display: none;
        }

        .hero::before {
          content: 'KTMCP';
          display: block;
          font-size: 3rem;
          font-weight: 900;
          color: var(--terminal-green);
          text-shadow: var(--glow);
          margin-bottom: 1rem;
        }

        .hero {
          padding: 3rem 0 2rem;
        }

        .tagline {
          font-size: 1.5rem;
        }

        .description {
          font-size: 0.9rem;
        }

        .cta-buttons {
          flex-direction: column;
          gap: 1rem;
        }

        .btn {
          width: 100%;
          justify-content: center;
          text-align: center;
        }

        /* Stats on mobile */
        .stats {
          margin: 3rem 0 4rem;
          padding: 2rem 1rem;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 2rem;
        }

        .stat-number {
          font-size: 2rem;
        }

        .stat-label {
          font-size: 0.65rem;
        }

        /* Section spacing */
        section {
          margin: 4rem 0;
        }

        .section-title {
          font-size: 1.5rem;
        }

        .section-description {
          font-size: 0.85rem;
        }

        /* CLI cards on mobile */
        .cli-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .cli-card {
          font-size: 0.9rem;
        }

        .cli-card::before {
          font-size: 0.7rem;
        }

        .terminal-window {
          padding: 1rem;
          min-height: 180px;
        }

        .terminal-output {
          font-size: 0.7rem;
        }

        .cli-name {
          font-size: 1.1rem;
        }

        /* Why grid on mobile */
        .why-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .why-item {
          padding: 1.5rem;
        }

        .why-item h3 {
          font-size: 1rem;
        }

        .why-item p {
          font-size: 0.8rem;
        }

        /* Navigation on mobile */
        nav {
          font-size: 0.85rem;
        }

        .logo {
          font-size: 1.25rem;
        }

        .nav-links {
          gap: 1rem;
        }

        .nav-links a {
          font-size: 0.8rem;
        }

        /* Footer on mobile */
        footer {
          margin-top: 4rem;
          padding: 2rem 0 1.5rem;
        }

        .footer-content {
          font-size: 0.75rem;
        }

        .footer-links {
          font-size: 0.8rem;
          gap: 1.5rem;
        }
      }

      /* Tablet breakpoint */
      @media (min-width: 769px) and (max-width: 1024px) {
        .ascii-logo {
          font-size: 0.6rem;
        }

        .cli-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .why-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a href="/" class="logo">KTMCP</a>
          <div class="nav-links">
            <a href="#clis">clis</a>
            <a href="https://github.com/ktmcp-cli">github</a>
            <a href="https://www.npmjs.com/org/ktmcp-cli">npm</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <section class="hero">
          <pre class="ascii-logo">
██╗  ██╗████████╗███╗   ███╗ ██████╗██████╗
██║ ██╔╝╚══██╔══╝████╗ ████║██╔════╝██╔══██╗
█████╔╝    ██║   ██╔████╔██║██║     ██████╔╝
██╔═██╗    ██║   ██║╚██╔╝██║██║     ██╔═══╝
██║  ██╗   ██║   ██║ ╚═╝ ██║╚██████╗██║
╚═╝  ╚═╝   ╚═╝   ╚═╝     ╚═╝ ╚═════╝╚═╝
          </pre>

          <h1 class="tagline">
            <span class="highlight">Kill The MCP.</span> Use CLIs.
          </h1>

          <p class="description">
            MCPs should've just been CLIs with good docs so your AI could easily connect to any 3rd party API. We're fixing that.
          </p>

          <div class="cta-buttons">
            <a href="https://www.npmjs.com/org/ktmcp-cli" class="btn">Browse CLIs</a>
            <a href="https://github.com/ktmcp-cli" class="btn btn-secondary">GitHub</a>
          </div>
        </section>

        <div class="stats">
          <div class="stats-grid">
            <div class="stat">
              <div class="stat-number">5</div>
              <div class="stat-label">CLIs</div>
            </div>
            <div class="stat">
              <div class="stat-number">~10K</div>
              <div class="stat-label">LOC</div>
            </div>
            <div class="stat">
              <div class="stat-number">133+</div>
              <div class="stat-label">Docs</div>
            </div>
            <div class="stat">
              <div class="stat-number">MIT</div>
              <div class="stat-label">License</div>
            </div>
          </div>
        </div>

        <section id="clis">
          <div class="section-header">
            <h2 class="section-title">Available CLIs</h2>
            <p class="section-description">
              Starting with finance APIs. More coming soon - Stripe, Shopify, and others.
            </p>
          </div>

          <div class="cli-grid">
            {clis.map(cli => (
              <a
                href={`/${cli.slug}`}
                class="cli-card"
                data-package={cli.package}
              >
                <div class="terminal-window">
                  <pre class="terminal-output">{cli.terminalExample}</pre>
                </div>
                <div class="cli-info">
                  <div class="cli-name">{cli.name}</div>
                  <div class="cli-description">{cli.description}</div>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section>
          <div class="section-header">
            <h2 class="section-title">Why CLI over MCP?</h2>
            <p class="section-description">
              Direct API access beats abstraction layers.
            </p>
          </div>

          <div class="why-grid">
            <div class="why-item">
              <h3>Faster</h3>
              <p>Direct API calls. No server overhead. No protocol parsing.</p>
            </div>
            <div class="why-item">
              <h3>Cheaper</h3>
              <p>Zero hosting. Zero per-request fees. Just your API bill.</p>
            </div>
            <div class="why-item">
              <h3>Simpler</h3>
              <p>Standard Unix. Pipe, redirect, compose. You know this.</p>
            </div>
            <div class="why-item">
              <h3>Deterministic</h3>
              <p>Same input, same output. Every time. No surprises.</p>
            </div>
            <div class="why-item">
              <h3>Debuggable</h3>
              <p>See what's happening. Read the code. No black boxes.</p>
            </div>
            <div class="why-item">
              <h3>Portable</h3>
              <p>Got Node.js? You're done. No containers. No setup.</p>
            </div>
          </div>
        </section>
      </div>
    </main>

    <footer>
      <div class="container">
        <div class="footer-content">
          Built by Tom Granot with Claude Sonnet 4.5 • MIT License • 2026
        </div>
        <div class="footer-links">
          <a href="https://github.com/ktmcp-cli">github</a>
          <a href="https://www.npmjs.com/org/ktmcp-cli">npm</a>
          <a href="https://github.com/ktmcp-cli/billingo">docs</a>
        </div>
      </div>
    </footer>
  </body>
</html>
