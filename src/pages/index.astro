      pre code {
        background: none;
        padding: 0;
      }

      footer {
        text-align: center;
        padding: 4rem 0 2rem;
        color: #666;
        border-top: 1px solid var(--border);
        margin-top: 4rem;
      }

      .badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: var(--accent-dim);
        color: var(--bg);
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: bold;
        margin-bottom: 1rem;
      }
    </style>
  </head>
